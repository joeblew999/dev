amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

// Only builtins whose executables come from mise.toml (go) or the shell.
local linters = new Mapping {
    ["go_fmt"] = Builtins.go_fmt
    ["go_vet"] = Builtins.go_vet
    ["gomod_tidy"] = Builtins.gomod_tidy
    ["trailing_whitespace"] = Builtins.trailing_whitespace
    ["check_merge_conflict"] = Builtins.check_merge_conflict
    ["detect_private_key"] = Builtins.detect_private_key
    ["check_added_large_files"] = Builtins.check_added_large_files
}

hooks {
    ["pre-commit"] { steps = linters }
    ["check"] { steps = linters }
    ["fix"] { steps = linters }
}
