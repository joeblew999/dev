{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": ".claude/hooks/skill-gate",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "mise exec -- hk run check --safe --format json",
            "type": "command"
          }
        ]
      }
    ]
  }
}
