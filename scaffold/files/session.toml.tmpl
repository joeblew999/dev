# What this repo pins of its Claude Code session. `mise run session:sync`
# writes .claude/skills and the settings.json keys from it.
#
# A [source.<name>] block is a GitHub repo at a pinned commit and the skills
# taken from its skills/ directory, for an upstream that ships no releases. A
# tool that ships a packslip release (dev, hk) is pinned in mise.toml instead,
# and mise links its skill by version with no help from here.

sync_command = "mise run session:sync"

# The rest of the session, generated into .claude/settings.json by sync.
[claude]
# Marketplace plugins that must not load here: each ships a skill that would
# shadow a pinned one at a version nothing here controls.
blocked_plugins = [
  "claude-code@claude-skills",
  "mise@cc-skills",
  "itp@cc-skills",
]
# claude.ai connectors are per-developer and invisible to a fresh clone, so the
# repo declares its own servers in .mcp.json and approves them wholesale.
claude_ai_connectors = false
approve_mcp_servers = true
