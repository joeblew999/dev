.bin
/dev
/.dist/
# mise packslip skill links, created per developer by mise skills sync
.claude/skills/.mise-skills.json
.claude/skills/hk-configure
.claude/skills/hk-debug
# written per developer by the tool, so it keeps them out of git
.agents/skills/hk-configure
.agents/skills/hk-debug
.reports/

# the site is generated; only its source is committed
/site/public/
# `go build ./site/...` writes the generator's binary here, named for its
# directory. 4.5MB of it reached a commit before this line existed, and the
# large-file check did not stop it.
/gen
/site/fly/public/
/site/fly/urls.txt
/site/fly/csp.txt
