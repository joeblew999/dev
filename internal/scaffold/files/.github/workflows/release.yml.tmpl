name: Release

# On demand, with a version, for a large body of work; day to day a release
# is `mise run release <version>` on a developer's machine. Nothing runs on a
# tag push: a release is published exactly once, by whoever runs the task.
on:
  workflow_dispatch:
    inputs:
      version:
        description: "Version to release, e.g. 1.2.0"
        required: true

permissions:
  contents: write       # Tag, create the release, upload the bundle.
  id-token: write       # Log the signature.

jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v7.0.1
        with:
          fetch-depth: 0

      - name: Install mise
        uses: jdx/mise-action@v4.3.0

      # The same task a developer runs, signed with the same key from the
      # Actions secret (mise run secrets:ci PACKSLIP_SIGNING_KEY sets it).
      - name: Build, sign, publish
        run: mise run release ${{ inputs.version }}
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          PACKSLIP_SIGNING_KEY: ${{ secrets.PACKSLIP_SIGNING_KEY }}
