// Command __NAME__ is the first command of this repo: an HTTP server that
// answers /health, the hello world every topology proves before anything is
// built on it. It is a cli.Command: `__NAME__` alone serves (the default verb),
// `__NAME__ skill` writes its manual for the repo's agents, and `dev build
// cmd/__NAME__` keeps that manual current. `mise run __NAME__:run` serves it;
// `mise run __NAME__:check` vets and tests it. Beside it, a wrangler.toml would
// make it a Cloudflare Worker, a fly.toml a Fly app, and `dev` would deploy
// either.
package main

import (
	_ "embed"
	"fmt"
	"io"
	"log"
	"net/http"

	"github.com/joeblew999/dev/cli"
)

// app is the whole command: its verbs, and the manual rendered from them.
var app = cli.Command{
	Name:    "__NAME__",
	Default: "serve",
	Verbs: map[string]cli.Verb{
		"serve": {Run: serve, Usage: usage},
	},
	Head: head,
	Tail: tail,
}

func main() { cli.Main(app) }


// serve is `__NAME__ serve`, the default verb: the HTTP server.
func serve(verb string, args []string, stdout, stderr io.Writer) error {
	fs := cli.Flags(verb, stderr)
	addr := fs.String("addr", "127.0.0.1:8080", "address to listen on")
	rest, err := cli.ParseInterleaved(fs, args)
	if err != nil {
		return cli.Usagef("%s: %v", verb, err)
	}
	if len(rest) > 0 {
		return cli.Usagef("%s takes no arguments", verb)
	}
	log.Printf("__NAME__ on http://%s", *addr)
	if err := http.ListenAndServe(*addr, handler()); err != nil {
		return fmt.Errorf("listen on %s: %v (another process holds the port, or pass --addr)", *addr, err)
	}
	return nil
}

// handler is the one HTTP handler, shared by every runtime this command
// gets: native now, a Worker or a Fly app later.
func handler() http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /health", func(w http.ResponseWriter, r *http.Request) {
		fmt.Fprintln(w, "ok")
	})
	mux.HandleFunc("GET /", func(w http.ResponseWriter, r *http.Request) {
		fmt.Fprintln(w, "hello from __NAME__")
	})
	return mux
}

// usage, head and tail are the manual: the verbs' own usage, and the prose
// around them. Markdown files beside this one, not string constants, because
// a Go raw string is backtick-delimited and so cannot hold inline code —
// which is what keeps a `<placeholder>` from reaching a markdown renderer as
// an HTML tag. The verbs between head and tail are rendered from app, so the
// manual cannot drift from the binary; `dev build cmd/__NAME__` rewrites it
// and `go test` holds it.

//go:embed usage.md
var usage string

//go:embed head.md
var head string

//go:embed tail.md
var tail string
